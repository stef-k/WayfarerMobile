<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WayfarerMobile.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\WayfarerMobile\Data\Entities\OfflineSegment.cs" Link="Production\OfflineSegment.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Repositories\RepositoryBase.cs" Link="Production\RepositoryBase.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Repositories\ISegmentRepository.cs" Link="Production\ISegmentRepository.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Repositories\SegmentRepository.cs" Link="Production\SegmentRepository.cs" />
    <!-- Test Framework -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Mocking and Assertions -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="8.8.0" />

    <!-- Code Coverage -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- Shared dependencies for testing -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- Database for DatabaseService tests -->
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\WayfarerMobile.Core\WayfarerMobile.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\WayfarerMobile\Data\Entities\LocalTimelineEntry.cs" Link="Production\LocalTimelineEntry.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Repositories\ITimelineRepository.cs" Link="Production\ITimelineRepository.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\TimelineExportService.cs" Link="Production\TimelineExportService.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\TimelineImportService.cs" Link="Production\TimelineImportService.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\QueueExportService.cs" Link="Production\QueueExportService.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\QueueDrainService.cs" Link="Production\QueueDrainService.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\QueueRecoveryOperationCoordinator.cs" Link="Production\QueueRecoveryOperationCoordinator.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\RecoveryExportCoordinator.cs" Link="Production\RecoveryExportCoordinator.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Repositories\ILocationQueueRepository.cs" Link="Production\ILocationQueueRepository.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Interfaces\IActivitySyncService.cs" Link="Production\IActivitySyncService.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Entities\ActivityType.cs" Link="Production\ActivityType.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Services\LocationSyncCallbacks.cs" Link="Production\LocationSyncCallbacks.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Helpers\NetworkLoggingExtensions.cs" Link="Production\NetworkLoggingExtensions.cs" />
    <Compile Remove="Infrastructure\Entities\QueuedLocation.cs" />
    <Compile Include="..\..\src\WayfarerMobile\Data\Entities\QueuedLocation.cs" Link="Production\QueuedLocation.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Coverage settings for coverlet.msbuild -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura,lcov</CoverletOutputFormat>
    <CoverletOutput>./coverage/</CoverletOutput>
    <ExcludeByAttribute>GeneratedCodeAttribute,ObsoleteAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
    <!-- Include the Core library in coverage -->
    <Include>[WayfarerMobile.Core]*</Include>
    <!-- Exclude test assembly from coverage -->
    <Exclude>[WayfarerMobile.Tests]*</Exclude>
  </PropertyGroup>

</Project>
